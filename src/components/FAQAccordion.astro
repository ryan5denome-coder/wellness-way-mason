---
import { jsonLdString } from '../lib/schema';

interface FaqItem {
  question: string;
  answer: string; // plain text or simple HTML
}

interface Props {
  items: FaqItem[];
  emitSchema?: boolean;
  heading?: string;
}

const { items, emitSchema = true, heading } = Astro.props;

const faqSchema = emitSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<section class="faq" aria-label={heading ?? 'Frequently asked questions'}>
  {heading && <h2 class="faq-heading">{heading}</h2>}
  <div class="faq-list">
    {items.map((item, i) => (
      <details class="faq-item" name="faq-group" open={i === 0}>
        <summary>
          <span class="q-text">{item.question}</span>
          <svg class="indicator" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
        </summary>
        <div class="answer" set:html={item.answer} />
      </details>
    ))}
  </div>
</section>

{faqSchema && <script type="application/ld+json" set:html={jsonLdString(faqSchema)} />}

<style>
  .faq-heading {
    margin: 0 0 1.5rem;
    font-size: var(--text-3xl);
  }
  .faq-list {
    display: grid;
    gap: 0;
  }
  /* Questions are separated by one hairline each instead of sitting in
     individual boxes: the list reads as one object. */
  .faq-item {
    border-bottom: var(--hairline) solid var(--color-line);
  }
  .faq-item:first-child {
    border-top: var(--hairline) solid var(--color-line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 1.25rem 0.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-weight: 600;
    color: var(--color-ink-strong);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .q-text {
    color: var(--color-brand-primary-dark);
  }
  summary:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
    border-radius: var(--radius-sm);
  }
  .q-text {
    font-family: var(--font-heading);
    letter-spacing: var(--tracking-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    transition: color var(--duration-fast) var(--ease-soft);
  }
  .indicator {
    flex-shrink: 0;
    color: var(--color-brand-primary-dark);
    transition: transform var(--duration-normal) var(--ease-ios);
  }
  .faq-item[open] .indicator {
    transform: rotate(45deg);
  }
  .answer {
    padding: 0 2.5rem 1.5rem 0.25rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    max-width: 72ch;
  }
  .answer :global(p:first-child) { margin-top: 0; }
  .answer :global(p:last-child) { margin-bottom: 0; }
</style>
