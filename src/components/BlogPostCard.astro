---
import Card from './Card.astro';

interface Props {
  title: string;
  excerpt: string;
  href: string;
  image?: string;
  imageAlt?: string;
  date?: string | Date;
  author?: string;
  category?: string;
  readTime?: string;
}

const {
  title,
  excerpt,
  href,
  image,
  imageAlt = '',
  date,
  author = 'Dr. Ryan DeNome, DC',
  category,
  readTime,
} = Astro.props;

const dateObj = date ? (date instanceof Date ? date : new Date(date)) : null;
// Short month ("Nov 17, 2025") so author, date and read time hold one line
// at every card width instead of orphaning the read time on a second row.
const dateStr = dateObj
  ? dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<Card href={href} image={image} imageAlt={imageAlt} title={title} eyebrow={category}>
  <p class="post-excerpt">{excerpt}</p>
  <div slot="footer" class="post-meta">
    <span class="post-author">{author}</span>
    {dateStr && dateObj && <time class="post-date" datetime={dateObj.toISOString().slice(0, 10)}>{dateStr}</time>}
    {readTime && <span class="post-readtime">{readTime}</span>}
  </div>
</Card>

<style>
  .post-excerpt {
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    /* Row gap 0, and the separator is drawn as each item's own leading
       margin, so a wrapped row never starts with a stray dot. */
    gap: 0.15rem 0;
    margin-left: -1.25rem;
    align-items: center;
    color: var(--color-mute);
    font-size: var(--text-xs);
    clip-path: inset(0 0 0 1.25rem);
  }
  .post-meta > * { white-space: nowrap; }
  .post-author {
    color: var(--color-ink-muted);
    font-weight: 500;
    margin-left: 1.25rem;
  }
  .post-date, .post-readtime {
    font-variant-numeric: tabular-nums;
  }
  /* Negative margin + clip-path hides the dot of whichever item
     lands first on a wrapped row. */
  .post-date::before, .post-readtime::before {
    content: "·";
    display: inline-block;
    width: 1.25rem;
    text-align: center;
  }
</style>
