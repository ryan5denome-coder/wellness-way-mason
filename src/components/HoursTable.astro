---
import { clinic } from '../lib/site';

interface Props {
  highlightToday?: boolean;
}

const { highlightToday = true } = Astro.props;

// Determine "today" — server-side at build time, harmless that this is build-time
// not runtime since the highlight is purely cosmetic.
const todayName = new Date().toLocaleDateString('en-US', { weekday: 'long' });

// clinic.yml stores ranges with an en dash ("8:00am–5:00pm") because the
// schema.org opening-hours parser in lib/site.ts splits on it. The house
// style has no dashes in rendered copy, so display them as "8:00am to 5:00pm".
const displayHours = (h: string) => h.replace(/\s*[–—]\s*/g, ' to ');
---

<dl class="hours-table">
  {clinic.hours.map((row) => (
    <div class={`hours-row ${highlightToday && row.day === todayName ? 'is-today' : ''}`}>
      <dt>{row.day}</dt>
      <dd>{displayHours(row.hours)}</dd>
    </div>
  ))}
</dl>

<style>
  .hours-table {
    margin: 0;
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-sm);
  }
  .hours-row {
    display: grid;
    /* Fixed day column: every time starts on the same x, so the hours read
       as a column (the old max-content column moved with each day name). */
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.4rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius-inner);
  }
  .hours-row dt {
    font-weight: 600;
    color: var(--color-ink-strong);
    margin: 0;
  }
  .hours-row dd {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .is-today {
    background: var(--color-brand-primary-soft);
  }
  .is-today dt, .is-today dd {
    color: var(--color-ink-strong);
  }
</style>
