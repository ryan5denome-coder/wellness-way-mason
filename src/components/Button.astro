---
/**
 * Button — primary CTA + secondary + ghost + link variants.
 * Renders as <a> when href is provided, <button> otherwise.
 *
 * Soft UI Evolution treatment per uipro:
 *   - Subtle 200-300ms transitions
 *   - Soft shadows that lift on hover
 *   - Visible focus ring (WCAG AA+)
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'link' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
  fullWidth?: boolean;
  ariaLabel?: string;
  iconAfter?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  fullWidth = false,
  ariaLabel,
  iconAfter = false,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = [
  'btn',
  `btn-${variant}`,
  `btn-${size}`,
  fullWidth ? 'btn-full' : '',
  iconAfter ? 'btn-arrow' : '',
].filter(Boolean).join(' ');

const externalAttrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  {...externalAttrs}
>
  <span class="btn-label"><slot /></span>
  {iconAfter && (
    <svg
      class="btn-icon"
      aria-hidden="true"
      width="14"
      height="14"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M2.5 8h11M9.5 4l4 4-4 4" />
    </svg>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.2;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-soft),
      color var(--duration-fast) var(--ease-soft),
      border-color var(--duration-fast) var(--ease-soft),
      box-shadow var(--duration-normal) var(--ease-soft),
      transform var(--duration-fast) var(--ease-ios);
    white-space: nowrap;
    letter-spacing: -0.005em;
    /* A button must never be the reason its container outgrows the screen.
       Without this, a long label's min-content width propagates up through
       grid/flex parents — on /pricing it dragged both arm cards 65px past a
       375px viewport, clipped by the overflow-x guard rather than fixed. */
    max-width: 100%;
  }

  /* Below the phone breakpoint, a two-line button is correct and a card wider
     than the screen is not. Long CTAs ("Book a health restoration consult")
     wrap instead of forcing horizontal overflow. */
  @media (max-width: 30rem) {
    .btn {
      white-space: normal;
      text-wrap: balance;
    }
    /* A wrapped pill label centres; left-ragged lines in a pill look broken. */
    .btn:not(.btn-link) .btn-label { text-align: center; }
  }
  .btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .btn-sm { padding: 0.5rem 1.15rem; font-size: var(--text-sm); }
  .btn-md { padding: 0.75rem 1.5rem; font-size: var(--text-base); }
  .btn-lg { padding: 0.95rem 1.75rem; font-size: var(--text-base); }

  /* Where text-box trimming is supported (see global.css) the label box
     shrinks to cap height, about 0.47em shorter. Add it back as padding so
     the button keeps its height and the label sits optically centred. */
  @supports (text-box: trim-both cap alphabetic) {
    .btn-sm:not(.btn-link) { padding-block: 0.72rem; }
    .btn-md:not(.btn-link) { padding-block: 1rem; }
    .btn-lg:not(.btn-link) { padding-block: 1.2rem; }
  }

  .btn-full { width: 100%; }

  .btn-arrow .btn-icon {
    transition: transform var(--duration-fast) var(--ease-ios);
    display: inline-block;
    flex-shrink: 0;
  }
  .btn:hover .btn-icon {
    transform: translateX(3px);
  }
  /* Pressed state: 80ms compression confirms the tap, especially on touch
     where no hover exists. Drops the hover lift while pressed. */
  .btn:active {
    transform: scale(0.985);
    transition-duration: var(--duration-press);
  }

  /* Optical alignment: the arrow's visual weight sits right of its box, so a
     pill with an icon reads left-heavy at equal padding. Pull the trailing
     edge in slightly. Link-style buttons have no pill to balance. */
  .btn-arrow:not(.btn-link).btn-sm { padding-right: 0.95rem; }
  .btn-arrow:not(.btn-link).btn-md { padding-right: 1.3rem; }
  .btn-arrow:not(.btn-link).btn-lg { padding-right: 1.75rem; }

  /* Loading state for submit buttons: set aria-busy="true" + disabled. */
  .btn[aria-busy="true"],
  .btn:disabled {
    cursor: progress;
    opacity: 0.75;
    transform: none;
    box-shadow: none;
  }

  /* === Primary — TWW Green === */
  .btn-primary {
    background: var(--color-brand-primary);
    color: var(--color-ink-strong);
    box-shadow: var(--shadow-card);
  }
  .btn-primary:hover {
    background: var(--color-brand-primary-dark);
    color: var(--color-paper);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card-hover);
  }

  /* === Secondary: dark pill (the forest band colour) === */
  .btn-secondary {
    background: var(--color-band);
    color: var(--color-paper);
    box-shadow: var(--shadow-card);
  }
  .btn-secondary:hover {
    background: var(--color-band-raised);
    color: var(--color-paper);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card-hover);
  }

  /* === Inverse — for dark sections (white-bg button on dark bg) === */
  .btn-inverse {
    background: var(--color-paper);
    color: var(--color-ink-strong);
    box-shadow: var(--shadow-card);
  }
  .btn-inverse:hover {
    background: var(--color-brand-primary);
    color: var(--color-ink-strong);
    transform: translateY(-1px);
  }

  /* === Ghost: white pill with a hairline border. On the grey page tint a
     transparent outline disappears; a white surface reads as a button. === */
  .btn-ghost {
    background: var(--color-paper);
    color: var(--color-ink-strong);
    border-color: var(--color-line);
    box-shadow: 0 1px 2px rgba(21, 27, 22, 0.05);
  }
  .btn-ghost:hover {
    background: var(--color-band);
    color: var(--color-paper);
    border-color: var(--color-band);
    transform: translateY(-1px);
  }

  /* === Link — text-style === */
  .btn-link {
    background: transparent;
    color: var(--color-brand-primary-dark);
    padding: 0.25rem 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    text-decoration-skip-ink: auto;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    border-radius: var(--radius-sm);
    font-weight: 600;
    white-space: normal;
    /* Inline, so when the label wraps the arrow follows the last word
       instead of floating at the far edge of a flex row. */
    display: inline;
  }
  .btn-link .btn-icon {
    display: inline-block;
    vertical-align: -0.1em;
    margin-left: 0.35em;
    /* The arrow is not part of the link text: keep the underline off it. */
    text-decoration: none;
  }
  .btn-link:hover {
    color: var(--color-ink-strong);
    text-decoration-color: currentColor;
  }
</style>
