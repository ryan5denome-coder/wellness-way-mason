---
/**
 * Slim newsletter teaser. Single horizontal strip with one line of copy + a
 * jump link to the full <NewsletterSignup /> form (which lives in #newsletter).
 *
 * Designed to NOT compete with the page content. Quiet, branded, scannable.
 * Works wherever the page also includes <NewsletterSignup /> further down.
 */
---

<aside class="newsletter-teaser" aria-label="Newsletter teaser">
  <div class="teaser-inner">
    <p class="teaser-copy">
      <strong>Once a month:</strong> testing patterns and recovery stories from the clinic. No spam.
    </p>
    <a href="#newsletter" class="teaser-link">
      Sign up
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9.5 4l4 4-4 4" /></svg>
    </a>
  </div>
</aside>

<style>
  .newsletter-teaser {
    background: var(--color-brand-primary-soft);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.25rem;
    margin: 0;
  }
  .teaser-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .teaser-copy {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.4;
    flex: 1 1 18rem;
  }
  .teaser-copy strong {
    color: var(--color-ink-strong);
    font-weight: 600;
  }
  .teaser-link {
    color: var(--color-brand-primary-dark);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--duration-fast) var(--ease-soft);
  }
  .teaser-link:hover {
    color: var(--color-ink-strong);
  }
  .teaser-link svg {
    transition: transform var(--duration-fast) var(--ease-ios);
  }
  .teaser-link:hover svg {
    transform: translateX(3px);
  }
</style>
