<script>
  // Hero photo stack. Moving a card to the back is only a data-pos change;
  // CSS does the motion. Auto-advances through one full cycle, then rests.
  // Any interaction stops it for good, and reduced-motion never starts it.
  const root = document.querySelector<HTMLElement>('[data-stack]');
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.stack-card'));
    const ticks = Array.from(root.querySelectorAll<HTMLElement>('[data-stack-go]'));
    const top = root.querySelector<HTMLElement>('[data-stack-top]');
    const bottom = root.querySelector<HTMLElement>('[data-stack-bottom]');
    const n = cards.length;
    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      index = (next + n) % n;
      cards.forEach((card, i) => { card.dataset.pos = String((i - index + n) % n); });
      ticks.forEach((tick, i) => {
        if (i === index) tick.setAttribute('aria-current', 'true');
        else tick.removeAttribute('aria-current');
      });
      if (top) top.textContent = cards[index].dataset.top ?? '';
      if (bottom) bottom.textContent = cards[index].dataset.bottom ?? '';
    };
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    root.querySelector('[data-stack-next]')?.addEventListener('click', () => { stop(); show(index + 1); });
    root.querySelector('[data-stack-prev]')?.addEventListener('click', () => { stop(); show(index - 1); });
    ticks.forEach((tick, i) => tick.addEventListener('click', () => { stop(); show(i); }));
    root.querySelector('.stack-cards')?.addEventListener('click', () => { stop(); show(index + 1); });
    root.addEventListener('focusin', stop);
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerdown', stop);

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let steps = 0;
      timer = window.setInterval(() => {
        if (document.hidden) return;
        show(index + 1);
        steps += 1;
        if (steps >= n) stop();
      }, 4500);
    }
  }
</script>

