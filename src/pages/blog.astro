---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../components/SectionContainer.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import NewsletterTeaser from '../components/NewsletterTeaser.astro';
import Button from '../components/Button.astro';
import { clinic } from '../lib/site';

const posts = (await getCollection('posts')).sort((a, b) => {
  const da = a.data.date?.getTime() ?? 0;
  const db = b.data.date?.getTime() ?? 0;
  return db - da;
});

// All categories present in the corpus
const allCategories = Array.from(
  new Set(posts.flatMap((p) => p.data.categories ?? []))
).sort();

// Upcoming community events — surfaced on /blog so engaged readers see live
// gatherings, AND so event pages get a second inbound internal link (Semrush fix).
const now = new Date();
const upcomingEvents = (await getCollection('events'))
  .filter((e) => {
    const end = e.data.endDate ?? e.data.date;
    return e.data.recurring || !end || end >= now;
  })
  .sort((a, b) => (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0))
  .slice(0, 3);
---

<BaseLayout
  title="Chiropractic & Functional Health Blog | Mason, OH"
  description="Articles on chiropractic care, hormones, gut health, thyroid, and the test-don't-guess approach, from Dr. Ryan DeNome at The Wellness Way - Mason."
  appendBrand={false}
>
  <SectionContainer width="default" spacing="md" background="paper-soft">
    <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
    <div class="blog-hero" data-reveal>
      <h1>
        <span class="page-kicker">Health &amp; Wellness Blog</span>
        Real answers, <span class="accent">written to be understood.</span>
      </h1>
      <p class="lede">
        Thyroid, hormones, gut health, nutrition, and the questions patients actually
        ask, answered in plain English by Dr. Ryan DeNome, DC and the team
        at {clinic.brandName}.
      </p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="sm">
    <div data-reveal="up-sm">
      <NewsletterTeaser />
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="md">
    <div class="blog-head" data-reveal>
      <h2>Articles &amp; Recipes</h2>
      <p class="head-lede">
        Short reads on the patterns we see in the clinic, plus a few recipes worth
        keeping. Pick the topic that sounds like your week.
      </p>
    </div>
    {allCategories.length > 0 && (
      <div class="category-filter" role="navigation" aria-label="Filter by category" data-reveal="up-sm">
        <a href="#all" class="cat-link" data-cat="all" aria-current="true">All</a>
        {allCategories.map((cat) => (
          <a href={`#${cat}`} class="cat-link" data-cat={cat}>{cat.replace(/-/g, ' ')}</a>
        ))}
      </div>
    )}
    <div class="post-grid" id="posts">
      {posts.map((post) => (
        <div class="post-cell" data-cats={(post.data.categories ?? []).join(' ')}>
        <BlogPostCard
          title={post.data.title}
          excerpt={post.data.excerpt ?? ''}
          href={`/post/${post.id}`}
          image={post.data.image}
          imageAlt={post.data.imageAlt ?? post.data.title}
          date={post.data.date}
          author={post.data.author}
          category={post.data.categories[0]?.replace(/-/g, ' ')}
          readTime={post.data.readTime}
        />
        </div>
      ))}
    </div>
  </SectionContainer>

  <script is:inline>
    // Topic filter. The pills are plain #hash links, so /blog#gut-health is
    // shareable; this shows only the matching cards. Without JS every post
    // stays visible.
    document.addEventListener('DOMContentLoaded', () => {
      const pills = document.querySelectorAll('.cat-link[data-cat]');
      const cells = document.querySelectorAll('.post-cell');
      if (!pills.length || !cells.length) return;
      const known = new Set(Array.from(pills, (p) => p.dataset.cat));
      const apply = () => {
        let hash = '';
        try { hash = decodeURIComponent(location.hash.slice(1)); } catch {}
        const cat = known.has(hash) ? hash : 'all';
        pills.forEach((p) => {
          if (p.dataset.cat === cat) p.setAttribute('aria-current', 'true');
          else p.removeAttribute('aria-current');
        });
        cells.forEach((c) => {
          c.hidden = cat !== 'all' && !c.dataset.cats.split(' ').includes(cat);
        });
      };
      pills.forEach((p) => p.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(null, '', p.dataset.cat === 'all' ? location.pathname : '#' + p.dataset.cat);
        apply();
      }));
      window.addEventListener('hashchange', apply);
      apply();
    });
  </script>

  {upcomingEvents.length > 0 && (
    <SectionContainer width="default" spacing="md">
      <div class="events-strip" data-reveal>
        <h2>Join us in person.</h2>
        <p class="events-intro">Community gatherings at {clinic.brandName}. Free, open to all. Bring a friend.</p>
        <ul class="events-list">
          {upcomingEvents.map((evt) => (
            <li>
              <a href={`/event-details/${evt.id}`}>
                <strong>{evt.data.title}</strong>
                {evt.data.excerpt && <span>{evt.data.excerpt}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="events-more"><Button href="/events" variant="link" iconAfter>See all events</Button></p>
      </div>
    </SectionContainer>
  )}

  <SectionContainer width="default" spacing="lg" background="paper-soft">
    <div data-reveal="up-sm">
      <NewsletterSignup />
    </div>
  </SectionContainer>
</BaseLayout>

<style>
  .blog-hero h1 { font-size: var(--text-fluid-h1); margin: 0; line-height: 1; }
  /* .page-kicker (the SEO keyword line inside the H1) lives in global.css. */
  .blog-head {
    max-width: 70ch;
    margin: 0 0 1.75rem;
  }
  .blog-head h2 {
    margin: 0 0 1rem;
    font-size: var(--text-fluid-h2);
    line-height: 1.12;
    color: var(--color-ink-strong);
  }
  .head-lede {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: 1.6;
    margin: 0;
    max-width: 58ch;
  }
  .lede { color: var(--color-ink-muted); max-width: 60ch; font-size: var(--text-lg); line-height: 1.6; margin: 1.25rem 0 0; }
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 2rem;
    font-size: var(--text-sm);
  }
  .cat-link {
    background: var(--color-brand-primary-soft);
    color: var(--color-ink-strong);
    font-weight: 500;
    line-height: 1.2;
    padding: 0.7rem 0.95rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    text-transform: capitalize;
    transition: background-color var(--duration-fast) var(--ease-soft);
  }
  @supports not (text-box: trim-both cap alphabetic) {
    .cat-link { padding-block: 0.45rem; }
  }
  .cat-link:hover {
    background: var(--color-brand-primary-light);
    color: var(--color-ink-strong);
  }
  .cat-link[aria-current="true"] {
    background: var(--color-band);
    color: var(--color-paper);
  }
  .post-cell { display: grid; }
  .post-cell[hidden] { display: none; }
  .post-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
  }
  .events-strip h2 {
    font-size: var(--text-fluid-h2-sm);
    margin: 0 0 0.75rem;
    color: var(--color-ink-strong);
  }
  .events-intro {
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
  }
  .events-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
  }
  .events-list a {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--color-paper-soft);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) var(--ease-soft);
    height: 100%;
  }
  .events-list a:hover {
    background: var(--color-brand-primary-soft);
  }
  .events-list strong {
    color: var(--color-ink-strong);
    font-family: var(--font-heading);
    letter-spacing: var(--tracking-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    display: block;
    margin-bottom: 0.4rem;
  }
  .events-list span {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.5;
  }
  .events-more {
    margin: 1.5rem 0 0;
  }
</style>
