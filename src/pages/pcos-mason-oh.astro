---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import NewsletterTeaser from '../components/NewsletterTeaser.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { clinic, bylines } from '../lib/site';

/**
 * /pcos-mason-oh
 *
 * Written for a woman who ALREADY has the diagnosis. She is not looking for a
 * name for it. She has the name and nothing underneath it.
 *
 * House rules for this page:
 *   - No medications named, referenced, or implied anywhere. Not in the copy,
 *     not in the FAQ, not in the disclaimer.
 *   - No em dashes.
 *   - No list of what we decline to do. The page says what we do.
 */

const signs = [
  {
    title: 'Cycles you can’t plan around',
    body: 'Months of nothing, then two in four weeks, then one that runs a fortnight. You stopped trying to predict it a long time ago.',
  },
  {
    title: 'Hair in the wrong places, thinning in the right ones',
    body: 'Chin and upper lip and abdomen. And at the same time, more scalp than there used to be. Both trace back to androgen activity, and both usually get handled at the surface.',
  },
  {
    title: 'Jawline acne that ignores everything',
    body: 'Deep, slow to heal, worse the week before your period, and completely unmoved by whatever cleared your skin at seventeen.',
  },
  {
    title: 'Weight that goes straight to your middle',
    body: 'Not everywhere. The middle. And it happens in women whose BMI reads perfectly fine, which is exactly why it gets waved off.',
  },
  {
    title: 'Tired in a way sleep doesn’t touch',
    body: 'Can’t fall asleep, can’t stay asleep, or you’re awake at 3am and starving. Blood sugar and cortisol both live near this one.',
  },
  {
    title: 'Moods that don’t match your week',
    body: 'Anxious or flat or just off, with nothing in your life to pin it on. Usually filed under stress, and then nobody asks what the stress is doing to the rest of you.',
  },
];

const threeTs = [
  {
    title: 'Traumas',
    kicker: 'Physical stress',
    body: 'Old injuries, surgeries, accidents, and years of accumulated wear. Physical stress doesn’t stay where it happened. It pulls on the same stress response that governs cortisol, and cortisol sits upstream of a great deal of hormone signaling.',
  },
  {
    title: 'Toxins',
    kicker: 'Biochemical stress',
    body: 'Sugar and refined carbohydrate have the clearest line to insulin. Past that, it’s whatever your liver and gut have to process, plus the hormone-mimicking compounds in packaging, cookware, and the products you put on your skin. When the load outruns your capacity, signaling suffers.',
  },
  {
    title: 'Thoughts',
    kicker: 'Emotional stress',
    body: 'A nervous system stuck in fight or flight moves cortisol, sleep, digestion, and hormone signaling all at once. That’s physiology, not weakness, and it isn’t in your head. A plan that pretends otherwise is working against itself.',
  },
];

const panels = [
  {
    name: 'Female Panel',
    body: 'A wide look at the reproductive hormones instead of the two or three a short workup stops at.',
  },
  {
    name: 'DUTCH Complete Hormone Panel',
    body: 'A dried urine panel showing hormone metabolites, which is to say what your body did with a hormone after it made it. Not just how much was floating around the morning of your draw.',
  },
  {
    name: 'Blood sugar and insulin markers',
    body: 'Fasting insulin and HbA1c alongside glucose. Fasting insulin is the one most often left off, and it’s frequently where the pattern shows itself first.',
  },
  {
    name: 'Thyroid with Hormones Panel',
    body: 'A full thyroid picture rather than TSH on its own. Thyroid and reproductive hormones are tangled together closely enough that reading one without the other leaves you guessing.',
  },
  {
    name: 'Immuno Food Allergy Test',
    body: 'Your individual food reactions, which you can’t always feel. Inflammation you don’t notice is still inflammation your body is spending energy on.',
  },
  {
    name: 'Genova GI Effects with Parasitology',
    body: 'Gut function and microbial balance. Your gut takes part in clearing hormones out of the body, so it belongs in this conversation.',
  },
];

const doSteps = [
  {
    n: 1,
    title: 'We listen first',
    body: 'Your history, your cycle, what you’ve already had run, and what you want your health to let you do again. Bring any labs from the past year. If something’s been done recently, we’ll read it rather than repeat it.',
  },
  {
    n: 2,
    title: 'We test in depth',
    body: 'Panels chosen for your case, not pulled off a shelf. You see the reasoning and the cost of each one before anything gets ordered, and testing is always recommended rather than required.',
  },
  {
    n: 3,
    title: 'We go through it together',
    body: 'When your results are back, we sit down at your Plan of Care visit and walk the whole thing in plain English. What we found, what it points to, and what your body looks like it needs. You leave understanding your own labs.',
  },
  {
    n: 4,
    title: 'We build something you can live',
    body: 'Nutrition built around what your testing showed, lifestyle support, and hands-on chiropractic care. Adjusted as your body responds. You’re never handed a PDF and left to it.',
  },
];

const pcosFaqs = [
  {
    question: 'I’ve already had bloodwork done. Why would I run more?',
    answer:
      '<p>Because most workups are built to confirm the diagnosis, and yours already did that. What they’re usually not built to do is go a layer deeper: hormone metabolites, fasting insulin, a full thyroid picture, food reactivity, gut function. We’re not re-checking whether you have PCOS. We’re asking what else is happening in a body that arrived here.</p>',
  },
  {
    question: 'I don’t have cysts. Does that change anything?',
    answer:
      '<p>Not for us. Despite what the name suggests, cysts aren’t required, and plenty of women with PCOS show perfectly normal testosterone on a blood draw. Those two facts are a large part of why the condition gets missed in the first place, and why a narrow panel isn’t much use here.</p>',
  },
  {
    question: 'What actually happens at the Plan of Care visit?',
    answer:
      '<p>We sit down with your results and go through them together, marker by marker, in language that makes sense. You’ll see what came back, what stands out, and how the pieces connect. Then we build your plan from what’s actually on the page. That visit is where most women tell us they finally understood their own labs for the first time.</p>',
  },
  {
    question: 'How long before I feel different?',
    answer:
      '<p>Results usually come back within a few weeks, and we review them at your Plan of Care visit. Feeling different takes longer. Chronic hormone and metabolic patterns generally need three to six months of consistent work before meaningful change shows up. Anyone quoting you a faster number is guessing.</p>',
  },
  {
    question: 'What does this cost?',
    answer:
      '<p>The health restoration new patient visit is a flat $99. If you haven’t had recent testing, plan on somewhere between $300 and $700 on day one depending on which panels we run. The Plan of Care visit is $300. We walk through the reasoning and the cost of every panel before anything gets ordered. Full detail lives on our <a href="/pricing">pricing page</a>.</p>',
  },
  {
    question: 'Are you replacing my doctor?',
    answer:
      '<p>No. We work alongside your medical team, not around them. Keep your appointments, keep your relationships, and bring us into the parts of the picture nobody has looked at yet. If you want us to coordinate with your physician, say so and we will.</p>',
  },
];
---

<BaseLayout
  title="PCOS Testing &amp; Support | Mason, OH"
  description="In-depth PCOS testing in Mason, Ohio. Hormone metabolites, fasting insulin, thyroid, gut and food reactivity. For women who already have the diagnosis and still want the explanation."
>
  <SectionContainer width="default" spacing="md" background="paper-soft">
    <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'PCOS' }]} />
    <div class="pcos-hero" data-reveal>
      <h1>
        <span class="page-kicker">PCOS Testing &amp; Support in Mason, OH</span>
        You have the diagnosis. You still don’t have the explanation.
      </h1>
      <p class="lede">
        Someone finally put a name to it. Then the appointment ended, and you drove home with a
        label and every question you walked in with. Common isn’t the same as normal, and a
        diagnosis isn’t the same as an answer.
      </p>
      <div class="cta-row">
        <Button href={clinic.bookingUrl} variant="primary" size="lg" external iconAfter>
          Book Your Appointment
        </Button>
        <Button href="#what-we-test" variant="ghost" size="lg">
          See what we test
        </Button>
      </div>
    </div>
  </SectionContainer>

  <SectionContainer width="prose" spacing="lg">
    <div class="intro" data-reveal>
      <p>
        PCOS affects up to <strong>13% of women of reproductive age</strong>, and the World Health
        Organization estimates that as many as <strong>70% of them don’t know they have
        it</strong>.<sup><a href="#sources">1</a></sup> You’re in the smaller group. You got the
        name. What almost nobody in your position gets handed is the layer underneath it.
      </p>
      <p>
        A smoke detector isn’t the problem. It’s the notice that something else is. You can quiet
        the alarm and change the sound in the room without touching the reason it went off. We’d
        rather go looking for what set it off, and that takes real testing. We test, we don’t guess.
      </p>
    </div>
    <div data-reveal="up-sm">
      <NewsletterTeaser />
    </div>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-warm-tint" id="signs">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Sound Familiar</p>
      <h2 data-reveal>You already know these. Nobody connected them.</h2>
      <p class="value-line" data-reveal="up-sm">
        Each one arrives with its own tidy explanation, which is how a group of related things
        ends up living in six separate folders.
      </p>
    </div>
    <ul class="signs-grid">
      {signs.map((s) => (
        <li data-reveal="up-sm">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ul>

    <aside class="myth" data-reveal="up-sm">
      <h3>Two things the name gets wrong</h3>
      <p><strong>You don’t need cysts.</strong> Despite the word sitting right there in the name, they aren’t required.</p>
      <p><strong>Your testosterone can read normal.</strong> Plenty of women with PCOS have an unremarkable androgen draw.</p>
      <p class="myth-close">
        Go looking only for the two findings the name implies and you’ll clear a great many women
        who have it. It’s also why a short panel rarely tells you anything you didn’t already know.
      </p>
    </aside>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg" id="pcos-belly">
    <div class="section-head">
      <p class="eyebrow" data-reveal>One Complaint, Three Problems</p>
      <h2 data-reveal>“PCOS belly” isn’t one thing.</h2>
      <p class="value-line" data-reveal="up-sm">
        It’s usually three separate things stacked in the same place. They don’t respond to the
        same inputs, which is why the standard advice keeps missing.
      </p>
    </div>
    <ol class="belly-list">
      <li data-reveal="up-sm">
        <span class="belly-num" aria-hidden="true">1</span>
        <div>
          <h3>Subcutaneous fat</h3>
          <p>The layer just under the skin, the part you can pinch. Most responsive to food and movement, and the part nearly all the advice is aimed at.</p>
        </div>
      </li>
      <li data-reveal="up-sm">
        <span class="belly-num" aria-hidden="true">2</span>
        <div>
          <h3>Visceral fat</h3>
          <p>Deeper, wrapped around your organs, and metabolically busy. Closely tied to insulin signaling, and it runs high in plenty of women whose BMI is perfectly normal. Which is why “you’re not overweight” never lands as the reassurance it’s meant to be.</p>
        </div>
      </li>
      <li data-reveal="up-sm">
        <span class="belly-num" aria-hidden="true">3</span>
        <div>
          <h3>Bloating</h3>
          <p>Not fat at all. Distension that comes and goes across a day or a week, and usually a digestive conversation before it’s a hormonal one. The two talk to each other.</p>
        </div>
      </li>
    </ol>
    <p class="belly-close" data-reveal="up-sm">
      Three problems, three different investigations. Telling all three to eat less and move more
      is how a woman ends up concluding the problem must be her.
    </p>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-soft" id="three-ts">
    <div class="section-head">
      <p class="eyebrow" data-reveal>The Three T’s</p>
      <h2 data-reveal>Where we go looking.</h2>
      <p class="value-line" data-reveal="up-sm">
        Stress lands on a body in three ways. With PCOS all three are usually in play at once,
        which is exactly why pulling one lever tends to disappoint.
      </p>
    </div>
    <div class="t-grid">
      {threeTs.map((t) => (
        <article data-reveal="up-sm">
          <p class="t-kicker">{t.kicker}</p>
          <h3>{t.title}</h3>
          <p>{t.body}</p>
        </article>
      ))}
    </div>
  </SectionContainer>

  <SectionContainer width="narrow" spacing="lg" background="paper-warm-tint">
    <div class="carpenter" data-reveal>
      <p class="eyebrow">The Fireman and the Carpenter</p>
      <h2>Two good trades. Different jobs.</h2>
      <p>
        A fireman shows up with an axe and a hose. Both are exactly right when the house is
        burning, and you want that person to come when you call. But once the fire is out, an axe
        and a hose can’t rebuild anything. That was never what they were for.
      </p>
      <p>
        A carpenter does the other half. Look at what’s still standing, find where the structure
        went weak, and build it back. Neither trade replaces the other, and you’d never send a
        carpenter to a fire.
      </p>
      <p class="carpenter-close">
        We’re carpenters. We come in for the part that happens after, and alongside.
      </p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg" id="what-we-test">
    <div class="section-head">
      <p class="eyebrow" data-reveal>We Test</p>
      <h2 data-reveal>Three questions a short panel never asks.</h2>
    </div>
    <div class="triage" data-reveal="up-sm">
      <div class="triage-item">
        <h3>Production</h3>
        <p>Is your body making the right amount?</p>
      </div>
      <div class="triage-item">
        <h3>Conversion</h3>
        <p>Is it turning hormones into the forms it actually uses?</p>
      </div>
      <div class="triage-item">
        <h3>Elimination</h3>
        <p>Is it clearing out what it’s finished with?</p>
      </div>
    </div>
    <p class="triage-note" data-reveal="up-sm">
      A single blood level answers the first question and stays quiet on the other two. Two women
      can hand you the same number and be in completely different situations. Closing that gap is
      the entire point of testing properly.
    </p>

    <ul class="panel-list">
      {panels.map((p) => (
        <li data-reveal="up-sm">
          <h3>{p.name}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ul>
    <p class="panel-caveat" data-reveal="up-sm">
      Not everyone runs all of these. What makes sense depends on your history, your symptoms, and
      what you’ve already had done.
    </p>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-soft" id="how-it-goes">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What We Do</p>
      <h2 data-reveal>How this actually goes.</h2>
    </div>
    <ol class="do-list">
      {doSteps.map((s) => (
        <li data-reveal="up-sm">
          <span class="do-num" aria-hidden="true">{s.n}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg">
    <h2 class="section-h2" data-reveal>Questions women actually ask us.</h2>
    <FAQAccordion items={pcosFaqs} />
  </SectionContainer>

  <SectionContainer width="narrow" spacing="lg" background="paper-warm-tint">
    <div class="pcos-close" data-reveal>
      <h2>You have options.</h2>
      <p>
        You’re allowed to want the explanation and not just the label. You’re allowed to ask what
        was never looked at. You’re allowed to take up the whole appointment. And you’re allowed
        to start now, instead of waiting until it gets bad enough to feel worth it.
      </p>
      <div class="cta-row">
        <Button href={clinic.bookingUrl} variant="primary" size="lg" external iconAfter>
          Book Your Appointment
        </Button>
        <Button href="/new-patient-visits" variant="ghost" size="lg">
          What the first visit looks like
        </Button>
      </div>
      <p class="byline">{bylines.reviewed}</p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="md" id="newsletter">
    <NewsletterSignup />
  </SectionContainer>

  <SectionContainer width="prose" spacing="md" id="sources">
    <h2 class="sources-h2">Source</h2>
    <ol class="sources-list">
      <li>
        World Health Organization, <em>Polycystic ovary syndrome</em> fact sheet.
        <a href="https://www.who.int/news-room/fact-sheets/detail/polycystic-ovary-syndrome" target="_blank" rel="noopener noreferrer">who.int</a>
        Source for the prevalence figure (an estimated 8 to 13% of reproductive-aged women) and
        the estimate that up to 70% of affected women remain undiagnosed worldwide.
      </li>
    </ol>
    <p class="disclaimer">
      This page is here to teach, not to advise. It isn’t a substitute for diagnosis or care from
      your physician, and nothing on it is intended to diagnose, treat, cure, or prevent any
      disease. {clinic.brandName} works alongside your medical team.
    </p>
  </SectionContainer>
</BaseLayout>

<style>
  /* ==========================================================================
     Typographic polish: tighter tracking on display sizes, looser measure on
     body copy, and a little more air between sections than the site default.
     ========================================================================== */
  .pcos-hero {
    max-width: 44rem;
  }
  .page-kicker {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mute);
    font-weight: 500;
    margin: 0 0 1.1rem;
  }
  .pcos-hero h1 {
    letter-spacing: -0.028em;
  }
  .pcos-hero .lede {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin-bottom: 2.25rem;
    max-width: 40rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  .intro p {
    font-size: var(--text-lg);
    line-height: 1.68;
    margin-bottom: 1.35rem;
  }
  .intro sup a {
    text-decoration: none;
    font-size: 0.65em;
    padding-left: 0.15em;
    color: var(--color-mute);
  }

  .section-head {
    margin-bottom: 2.75rem;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-primary-dark);
    margin-bottom: 0.55rem;
  }
  .section-head h2,
  .section-h2 {
    letter-spacing: -0.018em;
  }
  .value-line {
    color: var(--color-ink-muted);
    max-width: 44rem;
    margin: 0.85rem 0 0;
    line-height: 1.65;
  }
  .section-h2 {
    margin-bottom: 1.75rem;
  }

  /* === Signs === */
  .signs-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.25rem;
  }
  .signs-grid li {
    background: var(--color-paper);
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-card);
  }
  .signs-grid h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-bottom: 0.55rem;
  }
  .signs-grid p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.62;
  }

  .myth {
    background: var(--color-paper);
    border: var(--hairline) solid var(--color-line);
    border-left: 3px solid var(--color-brand-primary);
    border-radius: var(--radius-lg);
    padding: 1.85rem;
    max-width: 46rem;
    box-shadow: var(--shadow-card);
  }
  .myth h3 {
    font-size: var(--text-xl);
    margin-bottom: 1rem;
  }
  .myth p {
    margin-bottom: 0.75rem;
    color: var(--color-ink-muted);
    line-height: 1.62;
  }
  .myth-close {
    margin-bottom: 0 !important;
    padding-top: 0.9rem;
    border-top: var(--hairline) solid var(--color-line-soft);
  }

  /* === Numbered lists (belly + what we do) === */
  .belly-list,
  .do-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 1.6rem;
  }
  .belly-list li,
  .do-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .belly-num,
  .do-num {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-primary-soft);
    color: var(--color-brand-primary-dark);
    border: var(--hairline) solid var(--color-brand-primary-light);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .belly-list h3,
  .do-list h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-bottom: 0.35rem;
  }
  .belly-list p,
  .do-list p {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.66;
  }
  .do-list {
    max-width: 46rem;
    margin-bottom: 0;
  }
  .belly-close {
    max-width: 44rem;
    color: var(--color-ink);
    font-weight: 500;
    border-left: 3px solid var(--color-brand-primary);
    padding-left: 1.15rem;
    line-height: 1.62;
  }

  /* === 3 T's === */
  .t-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }
  .t-grid article {
    background: var(--color-paper);
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.85rem;
    box-shadow: var(--shadow-card);
  }
  .t-kicker {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 0.35rem;
  }
  .t-grid h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.018em;
    margin-bottom: 0.7rem;
  }
  .t-grid article > p:last-child {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.66;
  }

  /* === Testing === */
  .triage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .triage-item {
    background: var(--color-paper-cool);
    border-radius: var(--radius-lg);
    padding: 1.3rem 1.45rem;
  }
  .triage-item h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-bottom: 0.3rem;
    color: var(--color-brand-primary-dark);
  }
  .triage-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.55;
  }
  .triage-note {
