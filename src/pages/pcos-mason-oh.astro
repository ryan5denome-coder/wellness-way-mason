---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import NewsletterTeaser from '../components/NewsletterTeaser.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { clinic, bylines } from '../lib/site';

/**
 * /pcos-mason-oh — PCOS funnel entry point.
 *
 * Synthesized from the parent brand's full PCOS library (31 articles). The
 * clinical protocol content in those articles — named botanicals for PCOS,
 * metformin and oral-contraceptive commentary, cancer-risk claims, and
 * "chiropractic supports hormone levels" — is deliberately NOT reproduced
 * here. All of it sits outside an Ohio DC's scope, and much of it is uncited
 * upstream or rests on rodent studies. What carries over is the framework
 * (3 T's), the testing rationale, and the emotional argument.
 *
 * Every prevalence figure on this page is WHO-sourced. See the sources block
 * at the foot of the page.
 */

const silentSigns = [
  {
    title: 'Cycles that skip, stack, or stall',
    body: "Months with nothing. Two in four weeks. One that runs a fortnight. Irregular ovulation is the most recognized sign, and it is still the one most often waved through as “just how you are.”",
  },
  {
    title: 'Hair showing up where you did not ask for it',
    body: 'Chin, upper lip, abdomen, inner thighs. Hair thinning at the crown at the same time. Both trace back to androgen activity, and both get treated cosmetically far more often than they get investigated.',
  },
  {
    title: 'Deep, slow-healing acne along the jaw',
    body: 'Different from teenage acne. It sits on the jawline, chin, and neck, it flares in the week before your period, and it does not respond to what worked when you were sixteen.',
    },
  {
    title: 'Weight that concentrates at the waist',
    body: "Not weight everywhere — weight in the middle, in a body that used to distribute it differently. And it shows up in women whose BMI reads perfectly normal, which is exactly why it gets missed.",
  },
  {
    title: 'Exhaustion that sleep does not fix',
    body: 'Trouble falling asleep, trouble staying asleep, or waking suddenly hungry in the middle of the night. Blood sugar and cortisol both sit close to this one.',
  },
  {
    title: 'Mood that does not match your life',
    body: 'Anxiety, low mood, or a persistent sense of being off. This gets attributed to stress and stops there, without anyone asking what the stress is doing to your physiology.',
  },
];

const threeTs = [
  {
    title: 'Traumas',
    kicker: 'Physical stress',
    body: "Old injuries, surgeries, accidents, and the accumulated load of years of physical strain. Physical stress does not stay local — it recruits the same stress response that governs cortisol, and cortisol sits upstream of a great deal of hormonal signaling.",
  },
  {
    title: 'Toxins',
    kicker: 'Biochemical stress',
    body: "Sugar and refined carbohydrate are the ones with the clearest line to insulin. Beyond diet: what your liver and gut have to process, and the endocrine-disrupting compounds in food packaging, cookware, and personal care products. When the load outpaces capacity, signaling suffers.",
  },
  {
    title: 'Thoughts',
    kicker: 'Emotional stress',
    body: "A nervous system running in fight-or-flight changes cortisol, sleep, digestion, and hormone signaling all at once. That is physiology, not weakness, and it is not all in your head. A plan that ignores it is a plan working against itself.",
  },
];

const panels = [
  {
    name: 'Female Panel',
    body: 'A broad look at the reproductive hormones, rather than the two or three a standard workup stops at.',
  },
  {
    name: 'DUTCH Complete Hormone Panel',
    body: 'A dried urine panel that shows hormone metabolites — what your body did with a hormone after it made it, not just how much was circulating on the morning of the draw.',
  },
  {
    name: 'Blood sugar and insulin markers',
    body: 'Fasting insulin and HbA1c alongside glucose. Fasting insulin in particular is routinely left off a standard PCOS workup, and it is often where the pattern shows up first.',
  },
  {
    name: 'Thyroid with Hormones Panel',
    body: 'A full thyroid picture rather than TSH alone. Thyroid and reproductive hormones are entangled closely enough that reading one without the other leaves you guessing.',
  },
  {
    name: 'Immuno Food Allergy Test',
    body: 'Individual food reactivity, which is not always something you can feel. Inflammation you cannot detect is still inflammation your body is managing.',
  },
  {
    name: 'Genova GI Effects with Parasitology',
    body: 'Gut function and microbial balance. The gut participates in clearing hormones out of the body, so it belongs in the conversation.',
  },
];

const pcosFaqs = [
  {
    question: 'Do you diagnose PCOS?',
    answer:
      '<p>No. A PCOS diagnosis comes from a physician — typically an OB/GYN or endocrinologist — using criteria that include imaging and a clinical exam. As a chiropractic physician, Dr. DeNome does not diagnose PCOS and does not manage it as a disease. What we do is run in-depth testing, walk you through what it shows, and support your body with chiropractic care, nutrition, and lifestyle guidance alongside the care your physician provides.</p>',
  },
  {
    question: 'I already have a PCOS diagnosis. What would you add?',
    answer:
      '<p>Usually depth. Most PCOS workups establish the diagnosis and then move to management, which means whole categories — fasting insulin, hormone metabolites, thyroid detail, food reactivity, gut function — often go unexamined. We are not re-litigating your diagnosis. We are asking what else is going on in a body that produced it.</p>',
  },
  {
    question: 'Should I stop my birth control or metformin?',
    answer:
      '<p>That is not our call, and we will not make it. Your prescribing physician makes decisions about your medication, and we never advise stopping anything. Tell us what you take and why — it is genuinely useful context — and keep those conversations with the person who prescribed it.</p>',
  },
  {
    question: 'Can you get rid of my PCOS?',
    answer:
      '<p>We will not promise that, and you should be cautious with anyone who does. PCOS is a chronic condition. What we can tell you is what your testing shows, what may be contributing, and what your options are for supporting the systems underneath it. Some women see meaningful change in how they feel. We cannot tell you in advance that you will be one of them.</p>',
  },
  {
    question: 'I do not have cysts. Can I still have PCOS?',
    answer:
      '<p>Yes. Despite the name, ovarian cysts are not required for a PCOS diagnosis, and not every woman with PCOS has elevated testosterone either. That is a large part of why the condition gets missed — people go looking for the two findings the name implies and stop when they do not find them.</p>',
  },
  {
    question: 'How much does testing cost?',
    answer:
      '<p>The health restoration new patient visit is a flat $99. For a patient with no recent prior testing, a typical first-day lab spend lands somewhere between $300 and $700 depending on which panels we run. We walk through the reasoning and the cost of each one before anything is ordered, and testing is always recommended rather than required. Full detail is on our <a href="/pricing">pricing page</a>.</p>',
  },
  {
    question: 'How long before I would know anything?',
    answer:
      '<p>Results typically come back within a few weeks, and we review them with you at a Plan visit. Change in how you actually feel is slower — chronic hormone and metabolic patterns generally take three to six months of consistent work before anything meaningful shows up. Anyone quoting you a faster number is guessing.</p>',
  },
];
---

<BaseLayout
  title="PCOS Testing &amp; Support | Mason, OH"
  description="In-depth PCOS testing in Mason, Ohio. Hormone metabolites, fasting insulin, thyroid, gut and food reactivity — the panels a standard workup often skips. Alongside your physician's care."
>
  <SectionContainer width="default" spacing="md" background="paper-soft">
    <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'PCOS' }]} />
    <div class="pcos-hero" data-reveal>
      <h1>
        <span class="page-kicker">PCOS Testing &amp; Support &mdash; Mason, OH</span>
        You were told it was normal. It is only common.
      </h1>
      <p class="lede">
        Irregular cycles. Hair where you do not want it and thinning where you do. Weight that
        settles at your waist no matter what you eat. You brought it up, and it was folded into
        one word &mdash; hormonal &mdash; and you left with a prescription and no explanation.
        Being dismissed is not the same as being well.
      </p>
      <div class="cta-row">
        <Button href={clinic.bookingUrl} variant="primary" size="lg" external iconAfter>
          Book Your Appointment
        </Button>
        <Button href="#what-we-test" variant="ghost" size="lg">
          See what we test
        </Button>
      </div>
    </div>
  </SectionContainer>

  <SectionContainer width="prose" spacing="lg">
    <div class="intro" data-reveal>
      <p>
        Polycystic ovary syndrome affects up to <strong>13% of women of reproductive age</strong>,
        and the World Health Organization estimates that as many as <strong>70% of them are
        undiagnosed</strong>.<sup><a href="#sources">1</a></sup> That second number is the one
        worth sitting with. It means the most common finding in PCOS is not a cyst or a hormone
        level. It is a woman who has never been told what is happening in her own body.
      </p>
      <p>
        A smoke detector going off is not the problem. It is the notice that something else is.
        Most care for PCOS spends its attention on the alarm &mdash; quieting the cycle, clearing
        the skin, managing the blood sugar &mdash; which is genuinely useful, and which is also
        why the underlying pattern so often goes unexamined. We would rather go looking for the
        fire. That takes real testing. We test, we do not guess.
      </p>
    </div>
    <div data-reveal="up-sm">
      <NewsletterTeaser />
    </div>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-warm-tint" id="signs">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What It Looks Like</p>
      <h2 data-reveal>The signs that get explained away.</h2>
      <p class="value-line" data-reveal="up-sm">
        PCOS rarely announces itself. It accumulates, and each piece of it has a ready
        explanation that lets everyone move on.
      </p>
    </div>
    <ul class="signs-grid">
      {silentSigns.map((s) => (
        <li data-reveal="up-sm">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ul>

    <aside class="myth" data-reveal="up-sm">
      <h3>Two things the name gets wrong</h3>
      <p>
        <strong>You do not need cysts.</strong> Despite what &ldquo;polycystic&rdquo; implies,
        ovarian cysts are not required for the diagnosis.
      </p>
      <p>
        <strong>Your testosterone can read normal.</strong> Not every woman with PCOS has
        elevated androgens on a blood draw.
      </p>
      <p class="myth-close">
        Both of these are why a narrow workup misses it. If you go looking only for the two
        findings the name suggests, you will clear a great many women who have it.
      </p>
    </aside>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg" id="pcos-belly">
    <div class="section-head">
      <p class="eyebrow" data-reveal>One Complaint, Three Problems</p>
      <h2 data-reveal>&ldquo;PCOS belly&rdquo; is not one thing.</h2>
      <p class="value-line" data-reveal="up-sm">
        It is usually three separate things stacked in the same place, and they do not respond
        to the same inputs. This is why the generic advice fails.
      </p>
    </div>
    <ol class="belly-list">
      <li data-reveal="up-sm">
        <span class="belly-num" aria-hidden="true">1</span>
        <div>
          <h3>Subcutaneous fat</h3>
          <p>The layer just under the skin, the part you can pinch. The most responsive to diet and activity, and the part most advice is actually aimed at.</p>
        </div>
      </li>
      <li data-reveal="up-sm">
        <span class="belly-num" aria-hidden="true">2</span>
        <div>
          <h3>Visceral fat</h3>
          <p>Deeper, wrapped around the abdominal organs. Metabolically active and closely tied to insulin signaling. It can be elevated in women whose BMI is entirely normal &mdash; which is why &ldquo;you are not overweight&rdquo; is not the reassurance it sounds like.</p>
        </div>
      </li>
      <li data-reveal="up-sm">
        <span class="belly-num" aria-hidden="true">3</span>
        <div>
          <h3>Bloating</h3>
          <p>Not fat at all. Distension that comes and goes across a day or a week, and usually a digestive conversation rather than a hormonal one &mdash; though the two are connected.</p>
        </div>
      </li>
    </ol>
    <p class="belly-close" data-reveal="up-sm">
      Three different problems, three different investigations. Telling all three to eat less and
      move more is why so many women conclude the problem must be them.
    </p>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-soft" id="three-ts">
    <div class="section-head">
      <p class="eyebrow" data-reveal>The Three T&rsquo;s</p>
      <h2 data-reveal>Where we look for what is driving it.</h2>
      <p class="value-line" data-reveal="up-sm">
        The Wellness Way sorts the stressors acting on a body into three categories. For PCOS,
        all three are usually in play at once &mdash; which is precisely why a single-lever fix
        so often disappoints.
      </p>
    </div>
    <div class="t-grid">
      {threeTs.map((t) => (
        <article data-reveal="up-sm">
          <p class="t-kicker">{t.kicker}</p>
          <h3>{t.title}</h3>
          <p>{t.body}</p>
        </article>
      ))}
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg" id="what-we-test">
    <div class="section-head">
      <p class="eyebrow" data-reveal>We Test</p>
      <h2 data-reveal>Three questions a standard panel rarely asks.</h2>
    </div>
    <div class="triage" data-reveal="up-sm">
      <div class="triage-item">
        <h3>Production</h3>
        <p>Is your body making the right amount?</p>
      </div>
      <div class="triage-item">
        <h3>Conversion</h3>
        <p>Is it converting hormones into the forms it actually uses?</p>
      </div>
      <div class="triage-item">
        <h3>Elimination</h3>
        <p>Is it clearing what it no longer needs?</p>
      </div>
    </div>
    <p class="triage-note" data-reveal="up-sm">
      A single-timepoint blood level answers the first question and is largely silent on the other
      two. Two women can show the same number and be in completely different situations. That is
      the gap in-depth testing is meant to close.
    </p>

    <ul class="panel-list">
      {panels.map((p) => (
        <li data-reveal="up-sm">
          <h3>{p.name}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ul>
    <p class="panel-caveat" data-reveal="up-sm">
      Not everyone runs all of these. Which panels make sense depends on your history, your
      symptoms, and what you have already had done &mdash; and you will see the reasoning and the
      cost before anything is ordered. Bring any labs from the past year; if something has been
      run recently we will read it rather than repeat it.
    </p>
  </SectionContainer>

  <SectionContainer width="narrow" spacing="lg" background="paper-warm-tint">
    <div class="carpenter" data-reveal>
      <p class="eyebrow">Why This Reads Differently</p>
      <h2>Two useful trades.</h2>
      <p>
        There is an analogy the parent brand uses that is worth borrowing. A fireman arrives with
        an axe and a hose. Both are the right tools when the house is burning, and you want that
        person to come when you call. But once the fire is out, an axe and a hose cannot rebuild
        anything.
      </p>
      <p>
        A carpenter does different work. Assess what is standing, find where the structure is
        weak, and build. Neither trade replaces the other, and it would be foolish to send a
        carpenter to a fire. Most PCOS care is fire-fighting, and it should be. We are here for
        the part that comes after, and alongside.
      </p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="md" background="paper-soft" id="boundaries">
    <h2 class="section-h2" data-reveal>What we will not do.</h2>
    <p class="value-line" data-reveal="up-sm">
      There is a lot of confident PCOS content on the internet. Here is where our lane ends.
    </p>
    <ul class="wont-grid">
      <li data-reveal="up-sm">
        <h3>Diagnose your PCOS</h3>
        <p>That belongs to your physician. We test, we explain, and we support.</p>
      </li>
      <li data-reveal="up-sm">
        <h3>Touch your prescriptions</h3>
        <p>Not your birth control, not your metformin, not anything else. Those decisions stay with the person who prescribed them.</p>
      </li>
      <li data-reveal="up-sm">
        <h3>Promise to cure or reverse it</h3>
        <p>PCOS is chronic. We will tell you what we find and what your options are, not what your outcome will be.</p>
      </li>
      <li data-reveal="up-sm">
        <h3>Replace your OB/GYN</h3>
        <p>We work alongside your medical team, and we would rather coordinate with them than around them.</p>
      </li>
    </ul>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg">
    <h2 class="section-h2" data-reveal>PCOS questions, answered plainly.</h2>
    <FAQAccordion items={pcosFaqs} />
  </SectionContainer>

  <SectionContainer width="narrow" spacing="lg" background="paper-warm-tint">
    <div class="pcos-close" data-reveal>
      <h2>You have options.</h2>
      <p>
        You are allowed to want an explanation and not just a prescription. You are allowed to
        ask what else was never tested. You are allowed to take up the whole appointment. And
        you are allowed to start now, rather than waiting until it gets bad enough to justify it.
      </p>
      <div class="cta-row">
        <Button href={clinic.bookingUrl} variant="primary" size="lg" external iconAfter>
          Book Your Appointment
        </Button>
        <Button href="/new-patient-visits" variant="ghost" size="lg">
          What the first visit looks like
        </Button>
      </div>
      <p class="byline">{bylines.reviewed}</p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="md" id="newsletter">
    <NewsletterSignup />
  </SectionContainer>

  <SectionContainer width="prose" spacing="md" id="sources">
    <h2 class="sources-h2">Sources</h2>
    <ol class="sources-list">
      <li>
        World Health Organization. <em>Polycystic ovary syndrome</em> fact sheet.
        <a href="https://www.who.int/news-room/fact-sheets/detail/polycystic-ovary-syndrome" target="_blank" rel="noopener noreferrer">who.int</a>
        &mdash; source for the prevalence figure (affects an estimated 8&ndash;13% of reproductive-aged
        women) and the estimate that up to 70% of affected women remain undiagnosed worldwide.
      </li>
    </ol>
    <p class="disclaimer">
      This page is for education. It is not medical advice, and it is not a substitute for
      diagnosis or care from your physician. The Wellness Way &ndash; Mason does not diagnose or
      treat polycystic ovary syndrome. Nothing here is intended to diagnose, treat, cure, or
      prevent any disease. Never start, stop, or change a prescribed medication without speaking
      to the physician who prescribed it.
    </p>
  </SectionContainer>
</BaseLayout>

<style>
  .pcos-hero {
    max-width: 46rem;
  }
  .page-kicker {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-mute);
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .pcos-hero .lede {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin-bottom: 2rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  .intro p {
    font-size: var(--text-lg);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .intro sup a {
    text-decoration: none;
    font-size: 0.7em;
    padding-left: 0.1em;
  }

  .section-head {
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-brand-primary-dark);
    margin-bottom: 0.5rem;
  }
  .value-line {
    color: var(--color-ink-muted);
    max-width: 46rem;
    margin: 0.75rem 0 0;
  }
  .section-h2 {
    margin-bottom: 1rem;
  }

  /* === Signs === */
  .signs-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }
  .signs-grid li {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }
  .signs-grid h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.5rem;
  }
  .signs-grid p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .myth {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-brand-primary);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    max-width: 46rem;
  }
  .myth h3 {
    font-size: var(--text-xl);
    margin-bottom: 0.9rem;
  }
  .myth p {
    margin-bottom: 0.7rem;
    color: var(--color-ink-muted);
  }
  .myth-close {
    margin-bottom: 0 !important;
    padding-top: 0.7rem;
    border-top: var(--hairline) solid var(--color-line-soft);
  }

  /* === PCOS belly === */
  .belly-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 1.5rem;
  }
  .belly-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .belly-num {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-primary-soft);
    color: var(--color-brand-primary-dark);
    border: 1px solid var(--color-brand-primary-light);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .belly-list h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.3rem;
  }
  .belly-list p {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.65;
  }
  .belly-close {
    max-width: 46rem;
    color: var(--color-ink);
    font-weight: 500;
    border-left: 3px solid var(--color-brand-primary);
    padding-left: 1.1rem;
  }

  /* === 3 T's === */
  .t-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.75rem;
  }
  .t-grid article {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
  }
  .t-kicker {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 0.3rem;
  }
  .t-grid h3 {
    font-size: var(--text-2xl);
    margin-bottom: 0.6rem;
  }
  .t-grid article > p:last-child {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.65;
  }

  /* === Testing === */
  .triage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .triage-item {
    background: var(--color-paper-cool);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
  }
  .triage-item h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.3rem;
    color: var(--color-brand-primary-dark);
  }
  .triage-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .triage-note {
    max-width: 46rem;
    color: var(--color-ink-muted);
    margin-bottom: 2.5rem;
  }

  .panel-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
