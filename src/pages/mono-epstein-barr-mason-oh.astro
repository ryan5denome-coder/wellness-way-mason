---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import GuideSignup from '../components/GuideSignup.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { clinic, bylines } from '../lib/site';

/**
 * /mono-epstein-barr-mason-oh
 *
 * Voice is built from Dr. DeNome's own Instagram caption, not from the parent
 * brand's article register. Short bimodal sentences, noun-first fragments,
 * second person throughout, technical terms stated bare and then cashed out in
 * lived experience rather than defined.
 *
 * House rules:
 *   - No em dashes, semicolons, or colons in body copy.
 *   - No medications, no vaccines, no supplements, no protocols.
 *   - Says what we do. Never a list of what we decline to do.
 *   - The titer claim is stated at the strength CDC actually supports. See the
 *     sources block. The caption's "old or active" binary is not what the
 *     panel delivers, so the page says what it does deliver instead.
 */

const triggers = [
  { t: 'Chronic stress', b: 'The kind that has been running for years, not the kind that ends on Friday.' },
  { t: 'Sleep that never quite lands', b: 'Short nights, broken nights, or eight hours that leave you flat.' },
  { t: 'Gut inflammation', b: 'Most of your immune system lives down there. When the gut is busy, the rest of the system is working short-handed.' },
  { t: 'Food reactions you can’t feel', b: 'A reaction doesn’t have to be dramatic to be constant. Quiet ones still cost you something every day.' },
  { t: 'Low vitamin D', b: 'Common in Ohio by February. Also one of the more studied nutrients in immune function.' },
  { t: 'Blood sugar on a roller coaster', b: 'Spikes and crashes are metabolic stress, and metabolic stress is immune stress.' },
  { t: 'Pregnancy and postpartum', b: 'Immune function shifts on purpose during pregnancy. That’s normal. It’s also a real change in the terrain.' },
];

const looksLike = [
  { t: 'Fatigue coffee can’t touch', b: 'Not tired. Emptied. You sleep and wake up owing more.' },
  { t: 'Thyroid antibodies climbing', b: 'The number moves before you feel anything change.' },
  { t: 'Ferritin in the tank', b: 'Iron storage on the floor, often alongside hair that sheds and a heart rate that runs high.' },
  { t: 'Glands that swell and settle and swell', b: 'Neck, jaw, armpit. It comes and goes, which is exactly why nobody chases it.' },
  { t: 'Foods you used to be fine with', b: 'Flushing. Itching. A headache an hour later. Same food you ate for thirty years.' },
  { t: 'Brain fog you started calling normal', b: 'Losing the word. Rereading the paragraph. You stopped mentioning it a while ago.' },
];

const steps = [
  {
    n: 1,
    t: 'We take the history nobody took',
    b: 'When you got sick. How long it took to come back. What was happening in your life the year things shifted. Bring any labs from the past year. If it was run recently, we read it instead of repeating it.',
  },
  {
    n: 2,
    t: 'We run the markers',
    b: 'EBV antibodies, and the panels that show what the rest of your system is doing while your immune system is busy. Thyroid with antibodies. Iron and ferritin. Vitamin D. Blood sugar and insulin. Food reactivity. Gut function. You see the reasoning and the cost before anything is ordered.',
  },
  {
    n: 3,
    t: 'We go through the results with you',
    b: 'At your Plan of Care visit we sit down and walk the whole thing, marker by marker. What came back. What stands out. How the pieces line up against the story you told us. You leave understanding your own labs.',
  },
  {
    n: 4,
    t: 'We work on the terrain',
    b: 'Nutrition built from what your testing showed. Sleep and stress support. Hands-on chiropractic care. Adjusted as your body responds, and reviewed against repeat markers rather than guesses.',
  },
];

const faqs = [
  {
    question: 'I had mono in high school. Does that mean I have this?',
    answer:
      '<p>No. Most people who had mono go on to be perfectly well, and most people carrying the virus never think about it again. Carrying it is the norm, not the exception. What matters is whether your symptoms line up with a system that’s working harder than it should, and testing is how you find out.</p>',
  },
  {
    question: 'My bloodwork was normal. Why would more testing help?',
    answer:
      '<p>Routine panels are built to screen for common problems, and EBV antibodies are not on them. Neither are thyroid antibodies, ferritin, or fasting insulin in most cases. Your results were not wrong. They were answering a narrower question than the one you came in with.</p>',
  },
  {
    question: 'What does the antibody panel actually tell you?',
    answer:
      '<p>It tells you whether you have met this virus, which most adults have, and whether the pattern looks like a recent first infection or one from years ago. That’s a real answer and it genuinely changes where we start. What an antibody level can’t do on its own is prove a virus is active right now, and any page that tells you otherwise is overselling the test. We read the pattern alongside everything else we run and alongside how you actually feel.</p>',
  },
  {
    question: 'How long does this take?',
    answer:
      '<p>Results are usually back within a few weeks and we review them at your Plan of Care visit. Feeling different takes longer. When the immune system has been carrying a load for years, meaningful change generally takes three to six months of consistent work. Anyone giving you a faster number is guessing.</p>',
  },
  {
    question: 'What does it cost?',
    answer:
      '<p>The health restoration new patient visit is a flat $99. If you haven’t had recent testing, plan on somewhere between $300 and $700 on day one depending on which panels we run. The Plan of Care visit is $300. Every panel gets explained and priced before it’s ordered. Full detail is on our <a href="/pricing">pricing page</a>.</p>',
  },
  {
    question: 'Do I keep seeing my own doctor?',
    answer:
      '<p>Yes. We work alongside your medical team. Keep your appointments and your relationships, and bring us into the part of the picture that has not been looked at yet. If you want your results sent over, say so and we will.</p>',
  },
];
---

<BaseLayout
  title="EBV &amp; Mono Testing in Mason, OH | Dr. DeNome"
  description="Explore EBV antibody testing in Mason, OH alongside thyroid, ferritin, vitamin D and other markers when fatigue persists after mono."
  appendBrand={false}
>
  <SectionContainer width="default" spacing="md" background="paper-soft">
    <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Mono and Epstein Barr' }]} />
    <div class="ebv-hero" data-reveal>
      <h1>
        <span class="page-kicker">Mono &amp; Epstein Barr Testing in Mason, OH</span>
        Mono doesn’t always leave. It just changes its name.
      </h1>
      <p class="lede">
        You were sixteen. You were wrecked for a few weeks. Then you got better and everybody
        moved on. Nobody told you the virus stays.
      </p>
      <div class="cta-row">
        <Button href="#get-the-guide" variant="primary" size="lg">
          Get the free guide
        </Button>
        <Button href={clinic.bookingUrl} variant="ghost" size="lg" external iconAfter>
          Book Your Appointment
        </Button>
      </div>
    </div>
  </SectionContainer>

  <SectionContainer width="prose" spacing="lg">
    <div class="intro" data-reveal>
      <p>
        Epstein Barr is one of the most common viruses on the planet. More than
        <strong>90% of adults</strong> carry antibodies to it, which means they met it at some
        point and their body handled it.<sup><a href="#sources">1</a></sup> After a first
        infection the virus doesn’t clear the way a cold clears. It settles into your B cells and
        stays for life.<sup><a href="#sources">1</a></sup>
      </p>
      <p>
        For almost everyone, that’s a non-event. Your immune system keeps it quiet and you never
        think about it again.
      </p>
      <p class="pull">
        Which is the whole point. Nearly everyone carries this. Nearly everyone is fine. So the
        virus was never the thing that changed.
      </p>
      <p>
        Something else did. Something made the job harder.
      </p>
    </div>
    <div data-reveal="up-sm" id="get-the-guide">
      <GuideSignup
        guide="ebv"
        heading="Find out if this is what is going on."
        blurb="A short guide on what reactivation actually looks like, what wakes it back up, and which markers are worth running before you accept another normal result."
        bullets={["What it looks like the second time, when it is not mono anymore", "The ordinary load that keeps the lid off", "What we run, and why a TSH on its own is not a thyroid panel"]}
      />
    </div>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-warm-tint" id="triggers">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What Changes The Terrain</p>
      <h2 data-reveal>Your immune system was already busy.</h2>
      <p class="value-line" data-reveal="up-sm">
        None of these are exotic. That’s the point. They are the ordinary load a body carries for
        years without anyone adding it up.
      </p>
    </div>
    <ul class="card-grid">
      {triggers.map((x) => (
        <li data-reveal="up-sm">
          <h3>{x.t}</h3>
          <p>{x.b}</p>
        </li>
      ))}
    </ul>
    <p class="grid-note" data-reveal="up-sm">
      Research connects some of these to immune function more firmly than others. Stress and
      vitamin D have the most behind them. The rest we treat as load worth measuring rather than
      settled science, because that’s what the evidence actually supports.
    </p>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg" id="looks-like">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Why Nobody Caught It</p>
      <h2 data-reveal>It almost never looks like mono.</h2>
      <p class="value-line" data-reveal="up-sm">
        No fever. No sore throat that sends you to bed. That was the first time, and the first
        time was twenty years ago. This shows up as something else entirely.
      </p>
    </div>
    <ul class="sign-list">
      {looksLike.map((x) => (
        <li data-reveal="up-sm">
          <h3>{x.t}</h3>
          <p>{x.b}</p>
        </li>
      ))}
    </ul>
    <aside class="normal-note" data-reveal="up-sm">
      <p>
        Every one of these has a ready explanation. You’re busy. You’re a mom. You’re getting
        older. Each one is reasonable on its own, and none of them ever gets checked against the
        others.
      </p>
    </aside>
  </SectionContainer>

  <SectionContainer width="narrow" spacing="lg" background="paper-soft" id="labs">
    <div class="labs-block" data-reveal>
      <p class="eyebrow">Your Labs Came Back “Fine”</p>
      <h2>They were answering a smaller question.</h2>
      <p>
        A routine panel is built to screen for common problems. It checks a handful of things
        well. EBV antibodies aren’t on it. Neither are thyroid antibodies, or ferritin, or fasting
        insulin, most of the time.
      </p>
      <p>
        Your results weren’t wrong. Nobody missed anything they were looking for. The markers that
        speak to this were never in the scope of that test.
      </p>
      <p class="labs-close">
        So the answer you got back was accurate, and it still wasn’t your answer.
      </p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg" id="titers">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What The Antibody Panel Tells You</p>
      <h2 data-reveal>Honest about what a titer can do.</h2>
    </div>
    <div class="titer-grid">
      <article data-reveal="up-sm">
        <h3>What it answers</h3>
        <p>
          Whether you’ve met this virus. Whether the pattern looks like a first infection that
          happened recently, or one that happened years ago. Those are two different starting
          points and they lead to two different conversations.<sup><a href="#sources">1</a></sup>
        </p>
      </article>
      <article data-reveal="up-sm">
        <h3>What it doesn’t</h3>
        <p>
          A high antibody level on its own doesn’t prove a virus is active today. Elevated levels
          can sit there for years.<sup><a href="#sources">1</a></sup> Anyone selling you a single
          number as proof is overselling the test.
        </p>
      </article>
    </div>
    <p class="titer-close" data-reveal="up-sm">
      That’s why we don’t run it alone. The antibody pattern goes on the table next to your
      thyroid, your iron, your vitamin D, your blood sugar, and your history. One marker is a
      data point. The set is a picture.
    </p>
  </SectionContainer>

  <SectionContainer width="wide" spacing="lg" background="paper-warm-tint" id="what-we-do">
    <div class="section-head">
      <p class="eyebrow" data-reveal>What We Do</p>
      <h2 data-reveal>How this goes.</h2>
    </div>
    <ol class="do-list">
      {steps.map((s) => (
        <li data-reveal="up-sm">
          <span class="do-num" aria-hidden="true">{s.n}</span>
          <div>
            <h3>{s.t}</h3>
            <p>{s.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </SectionContainer>

  <SectionContainer width="default" spacing="lg">
    <h2 class="section-h2" data-reveal>Questions people actually ask.</h2>
    <FAQAccordion items={faqs} />
  </SectionContainer>

  <SectionContainer width="narrow" spacing="lg" background="paper-soft">
    <div class="closer" data-reveal>
      <p class="closer-line">You’re not lazy.</p>
      <p class="closer-line">You’re not imagining it.</p>
      <p class="closer-line closer-last">Your immune system is occupied.</p>
      <p class="closer-body">
        Find out whether this is part of your picture. That’s the whole ask. One visit, the right
        markers, and a conversation where somebody walks you through your own results.
      </p>
      <div class="cta-row">
        <Button href={clinic.bookingUrl} variant="primary" size="lg" external iconAfter>
          Book Your Appointment
        </Button>
        <Button href="/new-patient-visits" variant="ghost" size="lg">
          What the first visit looks like
        </Button>
      </div>
      <p class="byline">{bylines.reviewed}</p>
    </div>
  </SectionContainer>

  <SectionContainer width="default" spacing="md" id="get-the-guide-footer">
    <GuideSignup
      guide="ebv"
      heading="Find out if this is what is going on."
      blurb="A short guide on what reactivation actually looks like, what wakes it back up, and which markers are worth running before you accept another normal result."
      bullets={["What it looks like the second time, when it is not mono anymore", "The ordinary load that keeps the lid off", "What we run, and why a TSH on its own is not a thyroid panel"]}
    />
  </SectionContainer>

  <SectionContainer width="default" spacing="md" id="newsletter">
    <NewsletterSignup />
  </SectionContainer>

  <SectionContainer width="prose" spacing="md" id="sources">
    <h2 class="sources-h2">Source</h2>
    <ol class="sources-list">
      <li>
        Centers for Disease Control and Prevention, <em>Laboratory Testing for Epstein-Barr
        Virus</em> and <em>About Epstein-Barr Virus</em>.
        <a href="https://www.cdc.gov/epstein-barr/php/laboratories/index.html" target="_blank" rel="noopener noreferrer">cdc.gov</a>
        Source for the statement that over 90% of adults carry antibodies to EBV, that the virus
        remains in the body for life after a first infection, that antibodies to both VCA and EBNA
        indicate infection from months to years earlier, and that high antibody levels can persist
        for years and are not on their own diagnostic of recent infection.
      </li>
    </ol>
    <p class="disclaimer">
      This page is here to teach. It is not medical advice and it is not a substitute for
      diagnosis or care from your physician. {clinic.brandName} does not diagnose or treat
      Epstein Barr virus or infectious mononucleosis, and nothing here is intended to diagnose,
      treat, cure, or prevent any disease. We work alongside your medical team.
    </p>
  </SectionContainer>
</BaseLayout>

<style>
  .ebv-hero { max-width: 44rem; }
  .page-kicker {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mute);
    font-weight: 500;
    margin: 0 0 1.1rem;
  }
  .ebv-hero h1 { letter-spacing: -0.028em; }
  .ebv-hero .lede {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin-bottom: 2.25rem;
    max-width: 38rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  .intro p {
    font-size: var(--text-lg);
    line-height: 1.68;
    margin-bottom: 1.35rem;
  }
  .intro sup a {
    text-decoration: none;
    font-size: 0.62em;
    padding-left: 0.15em;
    color: var(--color-mute);
  }
  .pull {
    font-family: var(--font-display);
    font-size: var(--text-xl) !important;
    line-height: 1.5 !important;
    color: var(--color-ink-strong);
    border-left: 3px solid var(--color-brand-primary);
    padding-left: 1.25rem;
    margin: 2rem 0 !important;
  }

  .section-head { margin-bottom: 2.75rem; }
  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-primary-dark);
    margin-bottom: 0.55rem;
  }
  .section-head h2,
  .section-h2 { letter-spacing: -0.018em; }
  .value-line {
    color: var(--color-ink-muted);
    max-width: 44rem;
    margin: 0.85rem 0 0;
    line-height: 1.65;
  }
  .section-h2 { margin-bottom: 1.75rem; }

  /* Trigger cards */
  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .card-grid li {
    background: var(--color-paper);
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.4rem;
    box-shadow: var(--shadow-card);
  }
  .card-grid h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-bottom: 0.45rem;
  }
  .card-grid p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .grid-note {
    max-width: 44rem;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.62;
    margin: 0;
  }

  /* Symptom rows */
  .sign-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    background: var(--color-paper);
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .sign-list li { padding: 1.35rem 1.5rem; }
  .sign-list li + li { border-top: var(--hairline) solid var(--color-line-soft); }
  .sign-list h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-bottom: 0.28rem;
  }
  .sign-list p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .normal-note {
    max-width: 44rem;
    border-left: 3px solid var(--color-brand-primary);
    padding-left: 1.15rem;
  }
  .normal-note p {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.66;
  }

  /* Labs block */
  .labs-block h2 { letter-spacing: -0.02em; margin-bottom: 1.1rem; }
  .labs-block p {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: 1.68;
    margin-bottom: 1.2rem;
  }
  .labs-close {
    color: var(--color-ink-strong) !important;
    font-family: var(--font-display);
    font-size: var(--text-xl) !important;
    line-height: 1.45 !important;
    margin-top: 1.75rem;
    margin-bottom: 0 !important;
    padding-top: 1.5rem;
    border-top: var(--hairline) solid var(--color-line);
  }

  /* Titers */
  .titer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .titer-grid article {
    background: var(--color-paper);
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
  }
  .titer-grid h3 {
    font-size: var(--text-xl);
    letter-spacing: -0.014em;
    margin-bottom: 0.6rem;
  }
  .titer-grid p {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.66;
  }
  .titer-grid sup a { text-decoration: none; font-size: 0.62em; color: var(--color-mute); }
  .titer-close {
    max-width: 44rem;
    color: var(--color-ink);
    font-weight: 500;
    border-left: 3px solid var(--color-brand-primary);
    padding-left: 1.15rem;
    line-height: 1.66;
  }

  /* Numbered steps */
  .do-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.6rem;
    max-width: 46rem;
  }
  .do-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .do-num {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-primary-soft);
    color: var(--color-brand-primary-dark);
    border: var(--hairline) solid var(--color-brand-primary-light);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .do-list h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-bottom: 0.35rem;
  }
  .do-list p {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.66;
  }

  /* Closer */
  .closer { text-align: center; }
  .closer-line {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: var(--color-ink-strong);
    margin: 0 0 0.35rem;
  }
  .closer-last { color: var(--color-brand-primary-dark); margin-bottom: 1.75rem; }
  .closer-body {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: 1.68;
    margin: 0 auto 2.25rem;
    max-width: 36rem;
  }
  .closer .cta-row { justify-content: center; }
  .byline {
    margin-top: 2.75rem !important;
    font-size: var(--text-sm) !important;
    color: var(--color-mute) !important;
    font-style: italic;
  }

  /* Sources */
  .sources-h2 { font-size: var(--text-xl); margin-bottom: 1rem; }
  .sources-list {
    padding-left: 1.2rem;
    margin: 0 0 1.85rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.62;
  }
  .disclaimer {
    font-size: var(--text-sm);
    color: var(--color-mute);
    line-height: 1.62;
    border-top: var(--hairline) solid var(--color-line);
    padding-top: 1.3rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .do-list li { grid-template-columns: 2.1rem 1fr; gap: 1rem; }
    .do-num { width: 2.1rem; height: 2.1rem; font-size: var(--text-sm); }
    .card-grid li, .titer-grid article { padding: 1.35rem 1.25rem; }
    .closer-line { font-size: var(--text-2xl); }
  }
</style>
