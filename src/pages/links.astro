---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { clinic, owner } from '../lib/site';

/**
 * /links — the link-in-bio destination.
 *
 * Entered from an Instagram / Facebook profile, so it renders `bare` (no site
 * header, footer, or sticky book bar): the whole page IS the navigation, and
 * duplicate chrome only competes with the link stack.
 *
 * noIndex on purpose — a link hub is thin by design and has no business
 * competing with /our-approach or /pricing in search results.
 *
 * Layout follows the `minimal-single-column` conversion pattern: one hero CTA
 * that owns the fold, at most three proof points, then everything else demoted
 * to a quiet secondary list. The first pass here gave all seven links equal
 * visual weight, which meant booking — the only action that earns money —
 * competed with "Meet Dr. DeNome" for attention.
 *
 * Brand palette and type are locked to the site design system and deliberately
 * NOT taken from the pattern's default (blue/purple/pink, Raleway body).
 */

/** Three max — a fourth stops being read. */
const proof = ['$99 first visit', 'No contracts', 'HSA & FSA accepted'];

/**
 * Time-boxed feature slot, above the booking CTA.
 *
 * Instagram traffic during a campaign arrives for the campaign, so for those
 * few days the thing they came for outranks the evergreen booking button. It
 * hides itself automatically once `until` has passed, because a link hub
 * advertising a workshop that already happened is worse than one that never
 * mentioned it. Set to null between campaigns.
 *
 * `until` is the end of the day the event happens, in UTC. This is evaluated
 * at build time, so the slot clears on the next deploy after that date rather
 * than at the stroke of midnight. Close enough for a link hub.
 */
const feature: { href: string; label: string; note: string; when: string; until: Date } | null = {
  href: '/mono-workshop',
  label: 'Free workshop: Epstein Barr and lingering fatigue',
  note: 'What a standard panel leaves out, and what a thorough workup covers.',
  when: 'Thursday, September 3 at 8:00 PM ET',
  until: new Date('2026-09-04T06:00:00Z'),
};

const showFeature = feature !== null && feature.until.getTime() > Date.now();

const links = [
  {
    href: '/our-approach',
    label: 'Start Here',
    note: 'The 3 T’s, the 4-step process, and why we test instead of guess.',
  },
  {
    href: '/new-patient-visits',
    label: 'New Patient Visit Schedule',
    note: 'Every first visit mapped out: what to bring, what happens, what it costs.',
  },
  {
    href: '/our-services',
    label: 'Our Services',
    note: 'Chiropractic care, functional lab testing, and health restoration.',
  },
  {
    href: '/pricing',
    label: 'Pricing & Lab Testing',
    note: 'Flat, upfront numbers. Cash-pay, HSA and FSA accepted.',
  },
  {
    href: '/dr-ryan-denome',
    label: 'Meet Dr. DeNome',
    note: 'Doctor of Chiropractic, Webster-certified, Mason, Ohio.',
  },
  {
    href: '/contact',
    label: 'Contact & Location',
    note: `${clinic.address.streetAddress} · ${clinic.address.addressLocality}, ${clinic.address.addressRegion}`,
  },
];
---

<BaseLayout
  bare
  noIndex
  title="Links | The Wellness Way - Mason"
  description="Everything in one place from The Wellness Way - Mason: book a visit, start here, new patient visit schedule, services, and pricing. Mason, OH."
>
  <div class="linktree">
    <header class="lt-head">
      <img
        class="lt-mark"
        src="/images/brand/tww-logo.png"
        alt=""
        width="800"
        height="308"
        fetchpriority="high"
      />
      <h1>{clinic.brandName}</h1>
      <p class="lt-tagline">{clinic.tagline}</p>
      <p class="lt-meta">
        {owner.honorificPrefix} {owner.name.replace('Dr. ', '')}, {owner.credentials}
        <span aria-hidden="true">&middot;</span>
        {clinic.address.addressLocality}, {clinic.address.addressRegion}
      </p>

      <ul class="lt-proof">
        {proof.map((p) => <li>{p}</li>)}
      </ul>
    </header>

    {showFeature && feature && (
      <a href={feature.href} class="lt-feature">
        <span class="lt-feature-flag">Happening this week</span>
        <span class="lt-feature-label">{feature.label}</span>
        <span class="lt-feature-when">{feature.when}</span>
        <span class="lt-feature-note">{feature.note}</span>
      </a>
    )}

    <!-- The one action this page exists for. Everything below is secondary. -->
    <div class="lt-cta">
      <Button href={clinic.bookingUrl} variant="primary" size="lg" external fullWidth iconAfter>
        Book Your Appointment
      </Button>
      <p class="lt-cta-note">Real availability, booked online in about a minute.</p>
    </div>

    <nav class="lt-links" aria-labelledby="lt-explore">
      <h2 class="lt-eyebrow" id="lt-explore">Explore</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class="lt-link">
              <span class="lt-link-text">
                <span class="lt-link-label">{link.label}</span>
                <span class="lt-link-note">{link.note}</span>
              </span>
              <span class="lt-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="lt-newsletter" aria-label="Newsletter signup">
      <NewsletterSignup />
    </section>

    <footer class="lt-foot">
      <p class="lt-signature">Common is not normal.</p>
      <p class="lt-legal">
        <a href="/">thewellnesswaymason.com</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/privacy-policy">Privacy</a>
      </p>
      <p class="lt-byline">{owner.name}, {owner.credentials} &mdash; {owner.jobTitle}, Mason, Ohio</p>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Warm brand ground so the surfaces above it read as surfaces, not as page. */
  .linktree {
    min-height: 100vh;
    background:
      radial-gradient(120% 60% at 50% 0%, var(--color-brand-primary-soft) 0%, transparent 62%),
      var(--color-paper-warm-tint);
    padding: 2.75rem 1.25rem 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Between sections. Deliberately only ~2.5x the 0.625rem gap between
       bubbles, so the six links read as one group and each section reads as
       separate. At 2.5rem everything floated equally far apart and the page
       had no grouping at all. */
    gap: 1.75rem;
  }

  .linktree > * {
    width: 100%;
    max-width: 32rem;
  }

  /* Tap targets never wait on the 300ms click-delay heuristic, and no child
     of this page relies on hover to expose anything. The :global() half is
     required because <Button> carries its own scope id, so a page-scoped
     selector never reaches the one control that matters most here. */
  .linktree a,
  .linktree :global(.btn) {
    touch-action: manipulation;
    cursor: pointer;
  }

  /* === Head === */
  .lt-head {
    text-align: center;
  }
  .lt-mark {
    width: 92px;
    height: auto;
    margin: 0 auto 1.25rem;
    border-radius: var(--radius-md);
  }
  .lt-head h1 {
    font-size: var(--text-3xl);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  .lt-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-brand-primary-dark);
    margin-bottom: 0.6rem;
  }
  .lt-meta {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0;
  }
  .lt-meta span {
    margin: 0 0.35rem;
    color: var(--color-mute);
  }

  /* Three proof points, the reason to tap the CTA below. */
  .lt-proof {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }
  .lt-proof li {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-paper);
    border-radius: var(--radius-pill);
    padding: 0.34rem 0.75rem;
    box-shadow: 0 1px 2px rgba(31, 34, 34, 0.06);
  }

  /* === Primary CTA === */
  .lt-cta {
    text-align: center;
  }
  .lt-cta-note {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* === Secondary link list === */
  /* Each row is its own raised bubble. The booking button still outranks them
     because it is the only filled, coloured element on the page, so weight
     comes from colour rather than from these being visually flatter. */
  .lt-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin: 0 0 0.7rem;
    padding-left: 0.35rem;
  }
  /* Each row is its own card rather than one grouped block with dividers.
     Separate bubbles read as separate destinations, which is what this page
     is: six unrelated places to go, not one list to read down. */
  .lt-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .lt-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 1.15rem;
    text-decoration: none;
    color: var(--color-ink-strong);
    background: var(--color-paper);
    border-radius: 16px;
    /* Two shadows, not one. The tight first shadow reads as the card's edge and
       replaces the 1px border; the wide second one lifts it off the ground.
       A single heavy shadow reads as a drop shadow, which looks dated. */
    box-shadow:
      0 1px 2px rgba(31, 34, 34, 0.05),
      0 6px 16px -6px rgba(31, 34, 34, 0.10);
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--duration-fast) var(--ease-soft),
      box-shadow var(--duration-fast) var(--ease-soft),
      background var(--duration-fast) var(--ease-soft);
  }
  .lt-link:hover {
    background: var(--color-paper);
    color: var(--color-ink-strong);
    box-shadow:
      0 1px 2px rgba(31, 34, 34, 0.06),
      0 10px 24px -8px rgba(31, 34, 34, 0.16);
  }
  /* Press feedback rather than hover feedback. This page is almost entirely
     phone traffic, where hover does not exist and a tap needs to feel like it
     landed. */
  .lt-link:active {
    transform: scale(0.985);
    background: var(--color-brand-primary-soft);
    box-shadow: 0 1px 2px rgba(31, 34, 34, 0.05);
  }
  .lt-link:focus-visible {
    outline: 2px solid var(--color-brand-primary-dark);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .lt-link:active { transform: none; }
  }

  .lt-link-text {
    flex: 1;
    min-width: 0;
  }
  .lt-link-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1.3;
  }
  .lt-link-note {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .lt-arrow {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-mute);
    transition: transform var(--duration-fast) var(--ease-soft);
  }
  .lt-arrow svg {
    width: 100%;
    height: 100%;
  }
  .lt-link:hover .lt-arrow {
    transform: translateX(2px);
    color: var(--color-brand-primary-dark);
  }

  /* === Newsletter === */
  /* NewsletterSignup ships its own tinted MailerLite card, so this page adds
     no wrapper of its own — a card inside a card reads as a rendering bug.
     It only un-pins MailerLite's fixed-width email input, which is sized for
     a full-width section, not a 32rem link hub. */
  .lt-newsletter :global(.ml-form-embedWrapper) {
    border: 1px solid var(--color-line);
  }
  .lt-newsletter :global(.ml-form-fieldRow),
  .lt-newsletter :global(.ml-field-group),
  .lt-newsletter :global(.ml-form-fieldRow input) {
    width: 100% !important;
    max-width: 100% !important;
  }
  .lt-newsletter :global(.ml-form-embedSubmit),
  .lt-feature {
    display: block;
    text-decoration: none;
    background: var(--color-ink-strong);
    border-radius: 18px;
    padding: 1.25rem 1.3rem 1.35rem;
    -webkit-tap-highlight-color: transparent;
    box-shadow:
      0 1px 2px rgba(31, 34, 34, 0.10),
      0 12px 28px -10px rgba(31, 34, 34, 0.32);
    transition:
      transform var(--duration-fast) var(--ease-soft),
      box-shadow var(--duration-fast) var(--ease-soft);
  }
  .lt-feature:hover { background: var(--color-ink-strong); }
  .lt-feature:active { transform: scale(0.99); }
  .lt-feature:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .lt-feature:active { transform: none; }
  }
  .lt-feature-flag {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-primary);
    margin-bottom: 0.5rem;
  }
  .lt-feature-label {
    display: block;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.3;
    color: #ffffff;
    margin-bottom: 0.3rem;
  }
  .lt-feature-when {
    display: block;
    font-size: 0.88rem;
    color: var(--color-brand-primary);
    margin-bottom: 0.35rem;
  }
  .lt-feature-note {
    display: block;
    font-size: 0.86rem;
    line-height: 1.45;
    color: #b9bcbc;
  }

  .lt-newsletter :global(.ml-form-embedSubmit button.primary) {
    width: 100% !important;
  }

  /* === Foot === */
  .lt-foot {
    text-align: center;
    padding-top: 0.5rem;
  }
  .lt-signature {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }
  .lt-legal {
    font-size: var(--text-sm);
    margin-bottom: 0.6rem;
  }
  .lt-legal span {
    margin: 0 0.4rem;
    color: var(--color-mute);
  }
  .lt-byline {
    font-size: var(--text-xs);
    color: var(--color-mute);
    margin: 0;
  }

  @media (min-width: 40rem) {
    .linktree {
      padding-top: 4rem;
    }
    .lt-head h1 {
      font-size: var(--text-4xl);
    }
    .lt-link-label {
      font-size: var(--text-lg);
    }
  }
</style>
