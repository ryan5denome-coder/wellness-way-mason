---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { clinic, owner } from '../lib/site';

/**
 * /links — the link-in-bio destination.
 *
 * Entered from an Instagram / Facebook profile, so it renders `bare` (no site
 * header, footer, or sticky book bar): the whole page IS the navigation, and
 * duplicate chrome only competes with the link stack.
 *
 * noIndex on purpose — a link hub is thin by design and has no business
 * competing with /our-approach or /pricing in search results.
 */
const links = [
  {
    href: clinic.bookingUrl,
    external: true,
    featured: true,
    label: 'Book Your Appointment',
    note: 'New patient visits are a flat $99. Real availability, booked online.',
  },
  {
    href: '/our-approach',
    label: 'Start Here',
    note: 'The 3 T’s, the 4-step process, and why we test instead of guess.',
  },
  {
    href: '/new-patient-visits',
    label: 'New Patient Visit Schedule',
    note: 'Every first visit mapped out: what to bring, what happens, what it costs.',
  },
  {
    href: '/our-services',
    label: 'Our Services',
    note: 'Chiropractic care, functional lab testing, and health restoration.',
  },
  {
    href: '/pricing',
    label: 'Pricing & Lab Testing',
    note: 'Flat, upfront numbers. Cash-pay, HSA and FSA accepted, no contracts.',
  },
  {
    href: '/dr-ryan-denome',
    label: 'Meet Dr. DeNome',
    note: 'Doctor of Chiropractic, Webster-certified, Mason, Ohio.',
  },
  {
    href: '/contact',
    label: 'Contact & Location',
    note: `${clinic.address.streetAddress} · ${clinic.address.addressLocality}, ${clinic.address.addressRegion}`,
  },
];
---

<BaseLayout
  bare
  noIndex
  title="Links | The Wellness Way - Mason"
  description="Everything in one place from The Wellness Way - Mason: book a visit, start here, new patient visit schedule, services, and pricing. Mason, OH."
>
  <div class="linktree">
    <header class="lt-head">
      <img
        class="lt-mark"
        src="/images/brand/tww-logo.png"
        alt=""
        width="180"
        height="180"
        fetchpriority="high"
      />
      <h1>{clinic.brandName}</h1>
      <p class="lt-tagline">{clinic.tagline}</p>
      <p class="lt-meta">
        {owner.honorificPrefix} {owner.name.replace('Dr. ', '')}, {owner.credentials}
        <span aria-hidden="true">&middot;</span>
        {clinic.address.addressLocality}, {clinic.address.addressRegion}
      </p>
    </header>

    <nav class="lt-links" aria-label="The Wellness Way - Mason links">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class={link.featured ? 'lt-link lt-link-featured' : 'lt-link'}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="lt-link-text">
                <span class="lt-link-label">{link.label}</span>
                <span class="lt-link-note">{link.note}</span>
              </span>
              <span class="lt-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="lt-newsletter" aria-label="Newsletter signup">
      <NewsletterSignup />
    </section>

    <footer class="lt-foot">
      <p class="lt-signature">Common is not normal.</p>
      <p class="lt-legal">
        <a href="/">thewellnesswaymason.com</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/privacy-policy">Privacy</a>
      </p>
      <p class="lt-byline">{owner.name}, {owner.credentials} &mdash; {owner.jobTitle}, Mason, Ohio</p>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Warm brand ground so the white link cards read as cards, not as page. */
  .linktree {
    min-height: 100vh;
    background:
      radial-gradient(120% 60% at 50% 0%, var(--color-brand-primary-soft) 0%, transparent 62%),
      var(--color-paper-warm-tint);
    padding: 3rem 1.25rem 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
  }

  .linktree > * {
    width: 100%;
    max-width: 32rem;
  }

  /* === Head === */
  .lt-head {
    text-align: center;
  }
  .lt-mark {
    width: 92px;
    height: auto;
    margin: 0 auto 1.25rem;
    border-radius: var(--radius-md);
  }
  .lt-head h1 {
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .lt-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-brand-primary-dark);
    margin-bottom: 0.6rem;
  }
  .lt-meta {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0;
  }
  .lt-meta span {
    margin: 0 0.35rem;
    color: var(--color-mute);
  }

  /* === Link stack === */
  .lt-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.875rem;
  }

  .lt-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.05rem 1.15rem;
    text-decoration: none;
    color: var(--color-ink-strong);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-normal) var(--ease-soft),
      box-shadow var(--duration-normal) var(--ease-soft),
      border-color var(--duration-normal) var(--ease-soft);
  }
  .lt-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-brand-primary-light);
    color: var(--color-ink-strong);
  }
  .lt-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .lt-link-text {
    flex: 1;
    min-width: 0;
  }
  .lt-link-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .lt-link-note {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .lt-arrow {
    flex: none;
    width: 1.65rem;
    height: 1.65rem;
    color: var(--color-brand-primary-dark);
    transition: transform var(--duration-normal) var(--ease-soft);
  }
  .lt-arrow svg {
    width: 100%;
    height: 100%;
  }
  .lt-link:hover .lt-arrow {
    transform: translateX(3px);
  }

  /* Featured = the booking CTA. Brand green, inverted text. */
  .lt-link-featured {
    background: var(--color-brand-primary);
    border-color: var(--color-brand-primary-dark);
    color: #fff;
  }
  .lt-link-featured:hover {
    background: var(--color-brand-primary-dark);
    border-color: var(--color-brand-primary-dark);
    color: #fff;
  }
  .lt-link-featured .lt-link-note {
    color: rgba(255, 255, 255, 0.92);
  }
  .lt-link-featured .lt-arrow {
    color: #fff;
  }

  /* === Newsletter === */
  /* NewsletterSignup ships its own tinted MailerLite card, so this page adds
     no wrapper of its own — a card inside a card reads as a rendering bug.
     It only lifts the block onto the same shadow as the link stack and
     un-pins MailerLite's fixed-width email input, which is sized for a
     full-width section, not a 32rem link hub. */
  .lt-newsletter :global(.ml-form-embedWrapper) {
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-line);
  }
  .lt-newsletter :global(.ml-form-fieldRow),
  .lt-newsletter :global(.ml-field-group),
  .lt-newsletter :global(.ml-form-fieldRow input) {
    width: 100% !important;
    max-width: 100% !important;
  }
  .lt-newsletter :global(.ml-form-embedSubmit),
  .lt-newsletter :global(.ml-form-embedSubmit button.primary) {
    width: 100% !important;
  }

  /* === Foot === */
  .lt-foot {
    text-align: center;
    padding-top: 0.5rem;
  }
  .lt-signature {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }
  .lt-legal {
    font-size: var(--text-sm);
    margin-bottom: 0.6rem;
  }
  .lt-legal span {
    margin: 0 0.4rem;
    color: var(--color-mute);
  }
  .lt-byline {
    font-size: var(--text-xs);
    color: var(--color-mute);
    margin: 0;
  }

  @media (min-width: 40rem) {
    .linktree {
      padding-top: 4rem;
    }
    .lt-head h1 {
      font-size: var(--text-3xl);
    }
  }
</style>
